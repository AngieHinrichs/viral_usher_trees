                     /product="nonstructural protein NS2"
                     /note="N-terminus is cleaved by a cellular signal
                     peptidase; C-terminus is produced by the only known
                     cleavage event mediated by the NS2-NS3 metal-dependent
                     proteinase; membrane protein with 2 internal signal
                     sequences; suggested type III membrane topology protein;
                     inhibitor of CIDE-B-induced apoptosis"
                     /protein_id="NP_751923.1"
     mat_peptide     3420..5312
                     /gene="POLY"
                     /locus_tag="HCVgp1"
                     /product="protease/helicase protein NS3"
                     /note="N-terminus is produced by the only cleavage in HCV
                     polyprotein mediated by the NS2-NS3 metal-dependent
                     proteinase; cleaves itself at the C-terminus; with the help
                     of NS4A, mediates processing of all the other HCV
                     non-structural proteins; physically and functionally
                     interacts with the NS5B RNA polymerase; susceptible to
                     inhibition by the N-terminal cleavage products of substrate
                     peptides"
                     /protein_id="NP_803144.1"
