     mat_peptide     158..1012
                     /locus_tag="FCVgp1"
                     /product="p32"
                     /experiment="experimental evidence, no additional details
                     recorded"
                     /note="counterpart of the RHDV 23-KDa protein of Rabbit
                     hemorrhagic disease virus (RHDV) and the 45-KDa N-terminal
                     protein of Southampton virus (SHV); represents one of the
                     most divergent regions of polyprotein sequence within and
                     between Caliciviridae genera; thought to be functionally
                     similar to the 2B protein of picornaviruses that alone, or
                     as a part of its precursor, 2BC, is involved in membrane
                     modifications in virus infected cells; both N-termonal and
                     C-terminal cleavage sites were confirmed by direct
                     sequencing"
                     /protein_id="NP_783304.1"
     mat_peptide     1013..2074
                     /locus_tag="FCVgp1"
                     /product="NTPase"
                     /note="found in FCV membranous replication complexes;
